FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1
WORKDIR /workspace
COPY --from=ghcr.io/astral-sh/uv:0.12.15 /uv /uvx /bin/
COPY apps/api/pyproject.toml apps/api/README.md apps/api/uv.lock /workspace/apps/api/
RUN uv sync --project apps/api --locked --no-dev --no-install-project
COPY apps/api /workspace/apps/api
RUN uv sync --project apps/api --locked --no-dev
CMD ["uv", "run", "--project", "apps/api", "dramatiq", "engramloop.jobs.worker"]
