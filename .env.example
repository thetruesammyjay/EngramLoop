# Database and background jobs
DATABASE_URL=postgresql+asyncpg://engramloop:engramloop@localhost:5432/engramloop
REDIS_URL=redis://localhost:6379/0

# Model providers (keep secrets server-side)
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Clerk identity; configure both web and API values for authenticated use
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=engramloop-api
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Web app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Memory policy
MEMORY_RETENTION_DAYS=365
MEMORY_TOKEN_BUDGET=1200
MEMORY_PROVIDER=postgres

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
